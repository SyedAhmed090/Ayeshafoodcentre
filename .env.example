# MySQL / MariaDB. On Hostinger: hPanel → Databases → MySQL Databases.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Absolute path for menu photos, rider photos and payment screenshots, OUTSIDE public_html.
# Must be absolute: on Hostinger the server's working folder is not the project folder.
UPLOAD_DIR=""

# Port the custom server listens on (Hostinger sets PORT itself).
PORT="3000"

# Counter tablet PIN set by `npm run db:seed` (the owner can change it later in admin).
SEED_COUNTER_PIN="1234"

# First owner password for /admin, set by `npm run db:seed` only while none is set (8+ characters).
# The owner changes it in admin Settings; then remove it from here.
SEED_OWNER_PASSWORD=""

# Web Push for rider alerts. Generate once with `npx web-push generate-vapid-keys`; changing them
# makes every rider phone subscribe again. Empty = no push (the open app still rings).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"

# Nightly backups: absolute folder outside public_html, and the secret the Hostinger cron job sends (16+ characters).
BACKUP_DIR=""
CRON_SECRET=""
# Optional off-site copy: the nightly gzipped dump is emailed here (needs SMTP below).
BACKUP_EMAIL_TO=""
# A Hostinger mailbox works: smtp.hostinger.com, port 465, the mailbox address and its password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Rider APK (Trusted Web Activity, see DEPLOY.md "Rider APK"). Package name chosen when building the APK, and the
# SHA-256 fingerprint of its signing key (comma-separate if there are two). Empty = no APK, the rider web app still works.
RIDER_APP_PACKAGE=""
RIDER_APP_SHA256=""
