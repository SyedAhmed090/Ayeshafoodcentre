# MySQL / MariaDB. On Hostinger: hPanel → Databases → MySQL Databases.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Absolute path for menu photos, rider photos and payment screenshots, OUTSIDE public_html.
# Must be absolute: on Hostinger the server's working folder is not the project folder.
UPLOAD_DIR=""

# Port the custom server listens on (Hostinger sets PORT itself).
PORT="3000"

# Counter tablet PIN set by `npm run db:seed` (the owner can change it later in admin).
SEED_COUNTER_PIN="1234"
